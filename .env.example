# ============================================================
# PLACEMENTHUB - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables as needed.
# ============================================================

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# JWT Secret Key for Session Authentication (Change in production!)
JWT_SECRET=placement_hub_jwt_super_secret_key_2026_change_in_production

# JWT Expiration Period (e.g., 24h, 7d)
JWT_EXPIRES_IN=24h

# Database Path (Default SQLite file located inside server/data/)
DB_PATH=./server/data/placement.db

# Optional: CORS Allowed Origins (Comma-separated for strict origin verification)
# ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://placement.yourcollege.edu

# Optional External API Keys (Leave blank for built-in rule engines)
# OPENAI_API_KEY=
# RESUME_PARSER_API_KEY=
