# UNERA Environment Variables Configuration

# Server Port
PORT=5001

# AI Model API Keys (Optional - UNERA runs out of the box in zero-hallucination Demo Mode without keys)
# Set GEMINI_API_KEY or OPENAI_API_KEY if you want live external LLM generation
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database / Storage Mode (Defaults to local state store in server/data/unera_state.json)
DATABASE_MODE=local
